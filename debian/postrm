#!/bin/sh
set -e

# Mirror the enablement performed for the gpio@24 template instance in
# postinst. dh_installsystemd only cleans up the LED units it manages (via the
# ##DEBHELPER## expansion below), so gpio@24 is ours to undo.
#
# This previously called deb-systemd-helper, which cannot resolve a template
# instance and so recorded no state when enabling -- meaning disable and purge
# had nothing to act on and the wants symlink survived removal. Use the same
# offline-safe systemctl call the postinst now uses, and remove the symlink
# directly as a backstop for units enabled by the older postinst, which left
# no helper state behind for anything to find.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --root=/ disable gpio@24.service >/dev/null 2>&1 || true
    fi
    rm -f /etc/systemd/system/multi-user.target.wants/gpio@24.service
fi

# Our uart.d mapping is gone, so the capture must let go of the UART.
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl try-restart rpi-sb-uart-capture.service >/dev/null 2>&1 || true
fi

##DEBHELPER##

exit 0
