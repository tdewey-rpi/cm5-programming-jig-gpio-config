[Unit]
Description=CM5 programming jig status LED daemon
Documentation=man:cm5-programming-jig-gpio-config(1)
DefaultDependencies=no
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/cm5-provisioner-led
RuntimeDirectory=cm5-programming-jig-gpio-config
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
